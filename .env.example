# Port for next start (binds 127.0.0.1).
PORT=4111
# Model used by the intake agent: claude-sonnet-5-5, claude-opus-5-5 or claude-haiku-5-5.
INTAKE_MODEL=claude-sonnet-5-5
# Set to 1 to force replay mode (recorded agent runs, no login or key needed).
DEMO_REPLAY=0
# Optional: intake path override. live | replay | rules. Empty means automatic.
INTAKE_MODE=
# Optional: seconds before a live intake call falls back to the rules parser.
INTAKE_TIMEOUT_S=45
# Optional: use an API key instead of the local Claude Code login.
ANTHROPIC_API_KEY=
# Where the file-backed Postgres (PGlite) lives.
DATA_DIR=./data/pg
