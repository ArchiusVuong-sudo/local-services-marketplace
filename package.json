{
  "name": "local-services-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "A two-sided local services marketplace slice: describe a job, get matched pros, quote, hire, pay, review.",
  "author": "Khanh Vuong Tuan",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p ${PORT:-4111}",
    "demo": "next build && next start -H 127.0.0.1 -p ${PORT:-4111}",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "next build && playwright test",
    "test:live": "LIVE=1 vitest run tests/live.smoke.test.ts",
    "flow": "tsx scripts/flow.ts",
    "reset": "tsx scripts/reset.ts",
    "record:fixtures": "tsx scripts/record-fixtures.ts",
    "record:zips": "tsx scripts/record-zips.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@electric-sql/pglite": "^0.5.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
